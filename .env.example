# Copy to .env (in the repo root) and fill in.

# ---- server ----
PORT=3001
# Claude API key – enables AI recipe extraction (text + screenshots), suggestions, adaptation and "ask the chef"
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Public URL of the app (used in links sent over WhatsApp)
APP_PUBLIC_URL=http://localhost:3001
# Where the SQLite DB and uploaded images live (default: server/data)
# DATA_DIR=/var/lib/cheffo3
# Ingredient image providers, in order (shufersal, wikipedia), or "none"
IMAGE_PROVIDERS=shufersal,wikipedia
# Set SEED=0 to start with an empty recipe book
# SEED=0

# ---- WhatsApp Business Cloud API bot (optional) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Comma-separated phone numbers allowed to use the bot (international format, no +). Empty = anyone.
WHATSAPP_ALLOWED_NUMBERS=
