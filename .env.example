# Copy to .env (in the repo root) and fill in.

# ---- server ----
# ---- accounts (Netlify deployment) ----
# Google sign-in: OAuth "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Who may register: comma list of emails and/or domains ("@family.co.il"). Empty = anyone.
ALLOWED_EMAILS=
# Optional session signing key (generated and stored automatically when empty)
# SESSION_SECRET=

PORT=3001
# Claude API key – enables AI recipe extraction (text + screenshots), suggestions, adaptation and "ask the chef"
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI effort: low | medium | high (Netlify defaults to low to stay within the 60s function limit)
# AI_EFFORT=medium
# Public URL of the app (used in links sent over WhatsApp)
APP_PUBLIC_URL=http://localhost:3001
# Where the SQLite DB and uploaded images live (default: server/data)
# DATA_DIR=/var/lib/cheffo3
# Ingredient image providers, in order (shufersal, wikipedia), or "none"
IMAGE_PROVIDERS=shufersal,wikipedia
# Set SEED=0 to start with an empty recipe book
# SEED=0

# ---- WhatsApp Business Cloud API bot (optional) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta – verifies that webhook calls really come from WhatsApp (recommended)
WHATSAPP_APP_SECRET=
# Comma-separated phone numbers allowed to use the bot (international format, no +). Empty = anyone.
WHATSAPP_ALLOWED_NUMBERS=
